extends RefCounted
const Recovery = preload("res://tests/app_rebuild/test_save_recovery_ui.gd")
const StoreGuards = preload("res://tests/app_rebuild/test_save_recovery_guarded_initialization.gd")
const Controller = preload("res://game/app/run_controller.gd")
const Store = preload("res://game/persistence/game_save_store.gd")
const Core = preload("res://game/core/run_simulation.gd")
func run(t) -> void:
	_test_unknown_readback(t)
	_test_prewrite_same_intent(t)
	_test_unknown_wrong_authority(t)
	_test_initialization_lifecycle(t,"background")
	_test_initialization_lifecycle(t,"controller_lost")
func _test_unknown_readback(t) -> void:
	var validator = Core.new()
	var f := StoreGuards.new()._legacy(validator)
	var fault := func(stage): return ERR_CANT_CREATE if stage == "after_replace_before_return" else OK
	var app = Recovery.new()._restart_observed(t,f.directory,fault)
	var intent: Dictionary = app._pending_initialization.duplicate(true)
	t.check(app.game_save.is_empty() and intent.has("candidate"),"unknown initialization cannot publish an unconfirmed candidate")
	app.keep_saved_authority()
	app.save_store._fault_injector = Callable()
	app.retry_save_recovery()
	t.check(app._startup_view.is_empty() and app.game_save.career_id == intent.career_id and app.game_save.store_revision == 1,"explicit unknown initialization readback adopts same exact confirmed candidate once")
	t.check(app.profile.settings.reduce_effects and FileAccess.get_file_as_string(f.directory.path_join("profile.json")) == f.source,"confirmed initialization retains original settings and dev1 bytes")
	app.free()
func _test_prewrite_same_intent(t) -> void:
	var directory: String = Recovery.new()._unique_directory("initial_before_write")
	var fault := func(stage): return ERR_CANT_CREATE if stage == "write" else OK
	var app = Recovery.new()._restart_observed(t,directory,fault)
	var intent: Dictionary = app._pending_initialization.duplicate(true)
	t.check(not intent.is_empty() and app.game_save.is_empty(),"failed initial write retains one private career/source intent")
	app.keep_saved_authority()
	app.save_store._fault_injector = Callable()
	app.retry_save_recovery()
	t.check(app.game_save.career_id == intent.career_id and app.game_save.store_revision == 1,"initial write retry keeps the original requested career")
	app.free()
func _test_initialization_lifecycle(t,reason: String) -> void:
	var directory: String = Recovery.new()._unique_directory("initial_lifecycle")
	var app = Controller.new()
	var validator = Core.new()
	app.set_meta("test_validation_core",validator)
	app.save_store = Store.new(directory,Callable(validator,"restore"),func(stage):
		if stage == "after_replace_before_return": app._latch_lifecycle_pause(reason)
		return OK)
	t.root.add_child(app)
	app.set_process(false)
	app.world.set_process(false)
	t.check(not app.game_save.is_empty() and app._lifecycle_blocked(),"confirmed initial adoption retains latest "+reason+" intent")
	t.check(app.ui._mode == "save_recovery" and Recovery.new()._button_ids(app.ui) == ["recovery_continue"],"initial adoption interrupted by "+reason+" requires explicit continue overlay")
	t.check(not app.audio._music.playing and app.audio._last_played.is_empty() and app.input_router._touch == Vector2.ZERO,"initial lifecycle interruption freezes audio and retained movement")
	app.request_recovery_continue()
	t.check(app._startup_view.is_empty() and app.ui._mode == "title","explicit continue returns confirmed initial authority to title")
	app.save_store._fault_injector = Callable()
	app.free()
func _test_unknown_wrong_authority(t) -> void:
	var directory: String = Recovery.new()._unique_directory("initial_unknown_changed")
	var fault := func(stage): return ERR_CANT_CREATE if stage == "after_replace_before_return" else OK
	var app = Recovery.new()._restart_observed(t,directory,fault)
	var intent: Dictionary = app._pending_initialization.duplicate(true)
	var changed: Dictionary = intent.candidate.duplicate(true)
	changed.profile.settings.reduce_effects = true
	Recovery.new()._write(directory.path_join("game_save.json"),JSON.stringify(changed,"",true,true))
	app.save_store._fault_injector = Callable()
	app.retry_save_recovery()
	t.check(app.game_save.is_empty() and app._startup_view.get("error_code") == "stale_revision","unknown initial readback cannot adopt a changed candidate sharing the career")
	t.check(app._pending_initialization.sha256 == intent.sha256 and app._pending_initialization.career_id == intent.career_id,"foreign initial readback preserves original exact request identity")
	app.free()
