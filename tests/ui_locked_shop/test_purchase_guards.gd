extends RefCounted
const H = preload("res://tests/ui_locked_shop/helpers.gd")
func run(t) -> void:
	for case in [["active_run",H.active_view(),"field_bandage"],["insufficient",H.Fixture.new().supply_view("insufficient"),"doctrine_artillery"],["already_owned",H.Fixture.new().supply_view("owned"),"doctrine_mobile"],["inventory_full",H.Fixture.new().supply_view("full"),"field_bandage"]]:
		var h := H.create(t,case[1])
		await H.settle(t)
		t.check(await H.reach(t,h,"purchase:"+case[2]),case[0]+" is reachable for reading")
		await H.blocked_attempts(t,h,h.ui._supply_panel.item_button(case[2]),case[0])
		t.check(h.purchases.is_empty() and h.ui._supply_view == case[1],case[0]+" preserves exact input DTO and purchase intent count 0")
		h.viewport.free()
	for error in ["success","commit_outcome_unknown","write_failed","verify_failed","backup_failed","replace_failed"]:
		var view: Dictionary = H.Fixture.new().supply_view("affordable")
		var h := H.create(t,view)
		await H.settle(t)
		t.check(await H.reach(t,h,"purchase:field_bandage"),"normal product is reachable")
		H.joy(h.viewport,JOY_BUTTON_A,true)
		for ignored in range(8): H.joy(h.viewport,JOY_BUTTON_A,true)
		await H.settle(t,90)
		H.joy(h.viewport,JOY_BUTTON_A,false)
		t.check(h.purchases == [["field_bandage",int(view.view_revision)]],"normal GUI A/held A emits exactly one original purchase intent")
		t.check(h.ui._supply_locked and h.ui._supply_waiting_result,"normal purchase preserves in-flight lock")
		await H.blocked_attempts(t,h,h.ui._supply_panel.item_button("field_bandage"),"in-flight")
		h.ui.present_supply(view)
		await H.settle(t)
		H.check_focus(t,h,"purchase:field_bandage","in-flight same-view refresh")
		t.check(h.ui._supply_locked and h.ui._supply_waiting_result,"same revision does not unlock an in-flight request")
		h.ui.present_action_result({"action":"purchase","ok":error == "success","error_code":error})
		await H.blocked_attempts(t,h,h.ui._supply_panel.item_button("field_bandage"),error)
		h.ui.present_supply(view)
		await H.settle(t)
		H.check_focus(t,h,"purchase:field_bandage",error+" same-view refresh")
		t.check(h.ui._supply_locked and not h.ui._supply_waiting_result,error+" remains locked until new authority view")
		t.check(h.ui._supply_panel.display_text().contains("구매 완료" if error == "success" else H.UI.ShopPanel.reason_text(error)),error+" result remains available")
		var fresh := view.duplicate(true)
		fresh.view_revision += 1
		h.ui.present_supply(fresh)
		await H.settle(t)
		H.check_focus(t,h,"purchase:field_bandage",error+" fresh authority")
		t.check(not h.ui._supply_locked and not h.ui._supply_panel.item_button("field_bandage").disabled,"existing fresh authority rearm remains unchanged")
		t.check(h.purchases.size() == 1,"no purchase repeated by result/requery/focus restore")
		h.viewport.free()
	# GUI pointer positive control: zero emissions above cannot come from dead input.
	var h := H.create(t,H.Fixture.new().supply_view("affordable"))
	await H.settle(t)
	await H.reach(t,h,"purchase:field_bandage")
	var point: Vector2 = h.ui._supply_panel.item_button("field_bandage").get_global_rect().get_center()
	H.mouse(h.viewport,point,true)
	t.check(h.ui._supply_panel.item_button("field_bandage").is_pressed(),"enabled GUI mouse press arms real button")
	H.mouse(h.viewport,point,false)
	await H.settle(t)
	t.check(h.purchases == [["field_bandage",1]],"enabled GUI click emits exactly one normal purchase intent")
	h.viewport.free()
