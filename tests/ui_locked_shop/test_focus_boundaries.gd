extends RefCounted
const H = preload("res://tests/ui_locked_shop/helpers.gd")
func run(t) -> void:
	var view := H.active_view()
	var h := H.create(t,view)
	await H.settle(t)
	t.check(await H.reach(t,h,"purchase:doctrine_mobile"),"locked mobile card initially reached by D-pad")
	for target in H.TARGETS:
		h.viewport.size = target[1]
		h.ui.reflow(target[1],target[2])
		await H.settle(t)
		H.check_focus(t,h,"purchase:doctrine_mobile","rotation "+target[0])
		var old_panel_id: int = h.ui._supply_panel.get_instance_id()
		h.ui.present_supply(view)
		await H.settle(t)
		t.check(h.ui._supply_panel.get_instance_id() != old_panel_id,"same-view refresh replaces panel safely")
		H.check_focus(t,h,"purchase:doctrine_mobile","same-view refresh "+target[0])
	H.joy(h.viewport,JOY_BUTTON_B,true)
	H.joy(h.viewport,JOY_BUTTON_B,false)
	await H.settle(t)
	t.check(h.ui._mode == "title","cancel exits locked shop")
	h.ui.open_supply_shop()
	await H.settle(t)
	H.check_focus(t,h,"purchase:doctrine_mobile","reopen after cancel")
	h.ui.open_loadout()
	await H.settle(t)
	for ignored in range(h.ui._buttons.size()*2):
		H.direction(h,"down")
		await H.settle(t)
		t.check(not h.ui._buttons[h.ui._focus_index].disabled,"non-shop disabled loadout controls remain skipped")
	H.joy(h.viewport,JOY_BUTTON_B,true)
	H.joy(h.viewport,JOY_BUTTON_B,false)
	await H.settle(t)
	H.check_focus(t,h,"purchase:doctrine_mobile","return from preparation")
	h.ui.present_supply(view)
	await H.settle(t)
	H.check_focus(t,h,"purchase:doctrine_mobile","resume/requery presentation")
	t.check(h.purchases.is_empty() and h.ui._supply_view == view,"restoring readonly focus never buys or changes DTO")
	h.viewport.free()
	await _reject_invalid_read_targets(t,false)
	await _reject_invalid_read_targets(t,true)
	await _resume_paused_run(t)
func _reject_invalid_read_targets(t,locked: bool) -> void:
	var h := H.create(t,H.active_view())
	await H.settle(t)
	var cards: Array = h.ui._supply_panel.action_buttons()
	cards[0].hide()
	cards[1].set_meta("semantic_id","purchase:")
	cards[2].set_meta("semantic_id","purchase:unknown")
	h.ui._supply_locked = locked
	for ignored in range(6):
		H.direction(h,"down")
		await H.settle(t)
		t.check(h.ui.focused_semantic_id() in ["loadout_open","supply_back"],"hidden or malformed disabled card never becomes a read target")
	for id in ["purchase:doctrine_artillery","purchase:","purchase:unknown"]:
		h.ui._restore_focus(id)
		await H.settle(t)
		t.check(h.ui.focused_semantic_id() in ["loadout_open","supply_back"],"restore rejects hidden/malformed read target even with lock="+str(locked))
	# An arbitrary disabled button with valid-looking metadata is not a product.
	var alien: Button = h.ui._add_button("not a shop product",func(): pass)
	alien.disabled = true
	alien.set_meta("semantic_id","purchase:doctrine_artillery")
	for ignored in range(6):
		H.direction(h,"down")
		await H.settle(t)
		t.check(h.viewport.gui_get_focus_owner() != alien,"purchase metadata alone cannot grant read focus")
	h.viewport.free()

func _resume_paused_run(t) -> void:
	# Real Core snapshots, with pause transitions only; no Controller or disk I/O.
	var core_fixture = load("res://tests/core/new_current_regression_fixture.gd")
	var sim = core_fixture.simulation(t)
	var state: Dictionary = sim.new_run(core_fixture.chapter(),921,core_fixture.run_config())
	sim.set_pause(state,"user",true)
	var h := H.create(t,H.active_view())
	h.ui.close_supply_shop()
	h.ui.present(sim.snapshot(state))
	await H.settle(t)
	t.check(await H.reach(t,h,"shop_open"),"pause menu shop entry reached by D-pad")
	H.joy(h.viewport,JOY_BUTTON_A,true)
	H.joy(h.viewport,JOY_BUTTON_A,false)
	await H.settle(t)
	t.check(await H.reach(t,h,"purchase:field_bandage"),"paused run's locked bandage reached by D-pad")
	H.joy(h.viewport,JOY_BUTTON_B,true)
	H.joy(h.viewport,JOY_BUTTON_B,false)
	await H.settle(t)
	t.check(h.ui._mode == "pause" and h.ui.focused_semantic_id() == "shop_open","cancel restores original pause shop action")
	sim.set_pause(state,"user",false)
	h.ui.present(sim.snapshot(state))
	t.check(h.ui._mode == "play","Core resume snapshot returns to play")
	sim.set_pause(state,"user",true)
	h.ui.present(sim.snapshot(state))
	await H.settle(t)
	await H.reach(t,h,"shop_open")
	H.joy(h.viewport,JOY_BUTTON_A,true)
	H.joy(h.viewport,JOY_BUTTON_A,false)
	await H.settle(t)
	H.check_focus(t,h,"purchase:field_bandage","reopen after actual Core pause/resume snapshots")
	t.check(h.purchases.is_empty(),"pause/resume and modal-return focus never purchase")
	h.viewport.free()
